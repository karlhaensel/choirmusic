  \tag #'t { Herrn, nach den Vor -- hö -- fen des } \tag #'a { des } Herrn; \tag #'t { mein Leib, mein } \tag #'b { mein Leib, mein __ } \tag #'s \tag #'a { mein } Leib und See -- le
  
