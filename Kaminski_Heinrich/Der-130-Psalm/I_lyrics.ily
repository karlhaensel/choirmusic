\version "2.22.1"

tTutti = \lyricmode {
  Aus der Tie -- fe ru -- fe ich Herr, Herr! \tag #'s \tag #'t \tag #'b { Herr! } \tag #'a { Herr! __ }
  \tag #'s \tag #'a \tag #'t { Herr } \tag #'b { Herr __ } zu dir. Herr, \tag #'b { Herr! } hö -- re, \tag #'t { hö -- re, } \tag #'s \tag #'t { Herr __ } \tag #'a { Herr } \tag #'b { Herr, hö -- re, } hö -- re mei -- ne Stim -- me,
  lass dei -- ne Oh -- ren mer -- ken \tag #'s \tag #'a \tag #'t { auf } \tag #'b { auf __ } die Stim -- me mei -- nes Fle -- hens.
  
  \tag #'s { So du willst } \tag #'a { So du willst, Herr, so du willst } \tag #'t { So du willst, Herr, __ Sün -- de, Herr, __ } \tag #'b { So du willst, Herr, so du willst, Herr, __ Sün -- de zu -- rech -- nen, Herr, __ }
  Sün -- de zu -- rech -- nen, Herr! Herr! wer \tag #'s \tag #'t { wird __ } \tag #'a \tag #'b { wird } be ste -- hen? \tag #'t \tag #'b { wer? wer __ } \tag #'s \tag #'a { wer } \tag #'s \tag #'a \tag #'t { wird be -- ste -- hen? Denn bei } \tag #'b { wird __  be -- stehn? Denn bei dir, __ denn bei dir  }
  \tag #'s \tag #'a { dir __ } \tag #'t { dir, Herr, __ } ist die Ver -- ge -- bung;
  dass man \tag #'s \tag #'a { dich, Herr, } \tag #'t { dich, } \tag #'b { dich, __ } dass man dich fürch -- te.
}