\version "2.27.2"

allAnEinen = \lyricmode { all __ an ei -- nen Gott, } 

esStehtAlles = \lyricmode { es steht al -- les in sei -- ner Macht, }

tText = \lyricmode {
  \tag #'t \tag #'b { Wir __ gläu -- ben } 
    \tag #'I { \allAnEinen ei -- nen Gott, all __ an __ ei -- nen Gott, }
    \tag #'II { \repeat unfold 3 {\allAnEinen} }
    \tag #'t { \repeat unfold 4 {\allAnEinen} }
    \tag #'b { \repeat unfold 3 {\allAnEinen} an ei -- nen Gott, }
    
  Schöp -- fer \tag #'I \tag #'II \tag #'b {Him -- mels } \tag #'t {Him -- mels __ } und der Er -- den, \tag #'II {Him -- mels und der Er -- den, }
  
  \repeat unfold 3 {der sich zum Va -- ter ge -- ben hat,  }

  dass wir sei -- ne Kin -- der \tag #'I { wer -- den, __ } \tag #'II \tag #'t \tag #'b { wer -- den, }

  \tag #'I \tag #'II \tag #'b { er __ } \tag #'t { er } will \tag #'I \tag #'b { uns __ } \tag #'II \tag #'t { uns } \tag #'I \tag #'II { all -- zeit __  er -- näh -- ren, } \tag #'b {all -- zeit, all -- zeit er -- näh -- ren, } \tag #'t { all -- zeit  er -- näh -- ren, __ } \tag #'I { er -- näh -- ren, }
  
  \tag #'II { Leib und Seel auch, } \tag #'I \tag #'II \tag #'b { Leib und Seel auch wohl be -- wah -- ren, } \tag #'t { Leib und Seel auch wohl, auch wohl be -- wah -- ren, }
  
  al -- lem  Un -- fall will er weh -- ren, \tag #'I { will er weh -- ren, } 
  
  kein __ Leid \tag #'I \tag #'II { soll __ } \tag #'t \tag #'b { soll } uns wi -- der -- fah -- ren,  
  
  er sor -- get für __ \tag #'I \tag #'II \tag #'b { uns, }  \tag #'t { uns, __ } 
  
  \repeat unfold 2 { hüt't und wacht, } \tag #'I \tag #'II { und wacht, } und wacht, und wacht, 
  
  \tag #'t \tag #'II { \esStehtAlles \esStehtAlles  } \tag #'I { es __ steht al -- les, al -- les in sei -- ner Macht, } \tag #'t  { in sei -- ner Macht, } \tag #'b { \esStehtAlles } \tag #'II \tag #'t \tag #'b { in sei -- ner Macht, }
  \tag #'t \tag #'I { \esStehtAlles \esStehtAlles } \tag #'II { es steht al -- les,  al -- les } \tag #'t { in sei -- ner Macht, } \tag #'b { \esStehtAlles } in sei -- ner Macht.
}